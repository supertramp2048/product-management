extends ../../layouts/default.pug
include ../../mixins/alertSuccess.pug
include ../../mixins/hierarchyCategory.pug
block main 
  include ../../particals/confirmDelete.pug
  include ../../particals/loadingIcon.pug
  div
    +alertSuccess(3000)
    div 
      p(class="text-2xl") List of products
    div(class="flex items-center")
      div(class="p-8 flex gap-3 ")
      div 
    div
        div(class="flex flex-row-reverse") 
            a(href=`${prefixAdmin}/role/newRole` class="p-4 border border-green-600 rounded-lg active:bg-green-500") + add new role
        if roles.length > 0
          table 
            thead 
              th(class="border border-white p-2" ) 
                input(type="checkbox" check-all)
              th(class="border border-white p-2") STT
              th(class="border border-white p-2") Product's name 
              th(class="border border-white p-2") Description
              th(class="border border-white p-2") Action
            tbody 
              each role,index in roles   
                  tr 
                    td(class="border border-white p-2")
                      input(type="checkbox" check-item id=role._id)
                    td(class="border border-white p-2") #{index+1}
                    td(class="border border-white p-2") #{role.title}
                    td(class="border border-white p-2") #{role.description}
                    td(class="flex border border-white p-2") 
                        a(href=`${prefixAdmin}/roles/fixProduct/${role._id}` class="btn-primary mr-1") Fix
                        a(href=`${prefixAdmin}/roles/roleDetail/${role._id}` class="btn-primary mr-1") Detail
                        //-button(class="btn-primary" idProduct=role._id data-role=JSON.stringify(role) btn-action-fix="fix") Fix 
                        if role.delete == true 
                          button(class="bg-red-500 text-white px-4 py-2 rounded opacity-50 cursor-not-allowed" disabled) Deleted
                        else 
                          button(class="btn-danger" idProduct=role._id data-role=JSON.stringify(product) btn-action-delete="delete") Delete
        else  
          p There is nothing here
  //-- nut phan trang
  