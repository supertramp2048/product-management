extends ../../layouts/default.pug 
include ../../mixins/alertSuccess.pug
block main 
  +alertSuccess(3000)
  +alertFail(3000)
  div(class="container mx-auto p-6")
    h1(class="text-2xl font-bold text-gray-800 mb-6") Edit Account
    form(
        class="bg-white shadow-md rounded-lg p-6"
        action=`${prefixAdmin}/account/${account.id}/editAccountPatch?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
        id="form-edit-account"
    )
      table(class="w-full table-auto")
        tbody
          tr(class="leading-10")
            td(class="w-1/3 font-semibold text-gray-700 py-3") 
              label(for="fullName") Full name *
            td(class="py-3") 
              input(
                type="text" 
                id="fullName" 
                name="fullName" 
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Enter fullName"
                value=account.fullName
                required
              )
          tr(class="leading-10")
            td(class="w-1/3 font-semibold text-gray-700 py-3") 
              label(for="title") Email *
            td(class="py-3") 
              input(
                type="text" 
                id="email" 
                value=account.email
                name="email" 
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Enter email"
              )
          tr(class="leading-10")
            td(class="w-1/3 font-semibold text-gray-700 py-3") 
              label(for="title") Password *
            td(class="py-3") 
              input(
                type="Password" 
                id="password" 
                name="password" 
                value= account.password
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Enter password"
              )
          tr(class="leading-10")
            td(class="w-1/3 font-semibold text-gray-700 py-3") 
              label(for="phone") Phone number *
            td(class="py-3") 
              input(
                type="text" 
                id="phone" 
                name="phone" 
                 value=account.phone
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Enter phone number"
              )
          tr(class="leading-10")
            td(class="font-semibold text-gray-700 py-3")
              label(for="avatar") Avatar
            td(class="py-3")
              input(
                type="file" 
                id="avatar" 
                name="avatar" 
                class="form-control-file"
                accept="image/*"
                onchange= `previewFile()`
              )
              img(src= account.avatar, class="h-[80px] w-[100px]" previewImage alt="image of avatar")
          tr(class="leading-10")
            td(class="w-1/3 font-semibold text-gray-700 py-3") 
              label(for="phone") Permission 
            td(class="py-3") 
              select(name="role_id")
                each role in roles
                  option(value=role._id+"_"+role.title) #{role.title}  
          tr(class="leading-10")
            td(class="font-semibold text-gray-700 py-3")
              label(for="status") Status *
            td(class="py-3")
              select(
                name="status" 
                id="status" 
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              )
                option(value="active" selected) Active
                option(value="inactive") Inactive
          tr(class="leading-10")
            td(colspan="2" class="pt-6 text-right")
              button(
                type="button" 
                class="mr-3 px-4 py-2 text-gray-600 border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500"
                onclick= 'window.location.href="/admin/account"'
              ) Cancel
              button(
                type="submit" 
                class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50"
                id="submit-btn"
              ) Update Account