extends ../../layouts/default.pug
include ../../mixins/alertSuccess.pug
block main 
  div 
    +alertSuccess(3000)
    p(class="text-2xl pb-8") List of categories
    div
      div(class="flex justify-between")
        div 
          p Danh sách danh mục
        a(
          href=`${prefixAdmin}/productsCategory/createNewCategoryPage`
          class="p-4 border border-green-600 rounded-lg active:bg-green-500"
        ) + add new category
      div
        if categories.length > 0
          table 
            thead 
              th(class="border border-white p-2") 
                input(type="checkbox" check-all)
              th(class="border border-white p-2") STT
              th(class="border border-white p-2") Category name
              th(class="border border-white p-2") Image
              th(class="border border-white p-2") Status
              th(class="border border-white p-2") Action
            tbody 
              each category, index in categories
                tr 
                  td(class="border border-white p-2")
                    input(type="checkbox" check-item id=category._id)
                  td(class="border border-white p-2") #{index + 1}
                  td(class="border border-white p-2") #{category.title}
                  td(class="border border-white p-2")
                    if category.thumbnail
                      img(src=category.thumbnail class="w-[100px] h-[80px]" alt="img")
                    else
                      span N/A
                  td(class="border border-white p-2 w-[160px] text-center")
                    if category.status == "active"
                      button(class="btn-primary" id=category._id btn-isActive=category.status) Hoạt động
                    else 
                      button(class="btn-danger" id=category._id btn-isActive=category.status) Dừng hoạt động
                  td(class="flex border border-white p-2") 
                    a(href=`${prefixAdmin}/productsCategory/fixCategoryPage/${category._id}` class="btn-primary mr-1") Fix
                    a(href=`${prefixAdmin}/productsCategory/categoryDetail/${category._id}` class="btn-primary mr-1") Detail
                    if category.delete == true
                      button(class="bg-red-500 text-white px-4 py-2 rounded opacity-50 cursor-not-allowed" disabled) Deleted
                    else 
                      button(class="btn-danger" idCategory=category._id data-category=JSON.stringify(category) btn-action-delete="delete") Delete
        else  
          p There is nothing here
    form(
      action=""
      method="POST"
      id="form-change-status"
      name="form-change-status"
      data-path = `${prefixAdmin}/productsCategory/`
      ) 
  script(src="/admin/js/category.js") 
