extends ../../layouts/default.pug
include ../../mixins/alertSuccess.pug
include ../../mixins/ChooseCateParent.pug
block main
  +alertSuccess(3000)
  +alertFail(3000)
  div(class="container mx-auto p-6")
    h1(class="text-2xl font-bold text-gray-800 mb-6") Fix Category
    form(
        class="bg-white shadow-md rounded-lg p-6"
        action=`${prefixAdmin}/productsCategory/fixCategory/${Category._id}?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
        id="form-fix-category"
    )
      table(class="w-full table-auto")
        tbody
          tr(class="leading-10")
            td(class="w-1/3 font-semibold text-gray-700 py-3") 
              label(for="title") Title *
            td(class="py-3") 
              input(
                type="text" 
                id="title" 
                name="title" 
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="Enter category title"
                value=Category.title
              )
          tr(class="leading-10")
            td(class="w-1/3 font-semibold text-gray-700 py-3") 
              label(for="title") Parent ID *
            td(class="py-3") 
              select(name="parent_id") 
                option(value="") -- Khong chon -- 
                +choosenParent(categories,0,Category.parent_id)
          tr(class="leading-10")
            td(class="font-semibold text-gray-700 py-3")
              label(for="thumbnail") Thumbnail
            td(class="py-3")
              input(
                type="file" 
                id="thumbnail" 
                name="thumbnail" 
                class="form-control-file"
                accept="image/*"
                onchange= `previewFile()`
              )
              img(src=Category.thumbnail, class="h-[80px] w-[100px]" previewImage alt="image of product")
          tr(class="leading-10")
            td(class="font-semibold text-gray-700 py-3")
              label(for="description") Description
            td(class="py-3")
              textarea(
                name="description"
                id="description"
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="descripttion of category "
                ) !{Category.description} 
          tr(class="leading-10")
            td(class="font-semibold text-gray-700 py-3")
              label(for="delete") Deleted in client
            td(class="py-3")
              select(
                name="delete" 
                id="delete" 
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              )
                option(value="false" selected= Category.delete==false ) False
                option(value="true" selected= Category.delete==true) True
          tr(class="leading-10")
            td(class="font-semibold text-gray-700 py-3")
              label(for="status") Status *
            td(class="py-3")
              select(
                name="status" 
                id="status" 
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              )
                option(value="active" selected = Category.status == "active") Active
                option(value="inactive" selected = Category.status == "inactive") Inactive
          tr(class="leading-10")
            td(class="font-semibold text-gray-700 py-3") 
              label(for="position") Position
            td(class="py-3") 
              input(
                type="number" 
                min="1" 
                id="position" 
                name="position" 
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="1"
                value=Category.position
              )
          tr(class="leading-10")
            td(colspan="2" class="pt-6 text-right")
              button(
                type="button" 
                class="mr-3 px-4 py-2 text-gray-600 border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500"
                onclick="window.location.href=`/admin/productsCategory`"
              ) Cancel
              button(
                type="submit" 
                class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50"
                id="submit-btn"
              ) Fix Category
  script(src="/admin/js/category.js") 
  script(src="/tinymce/tinymce.min.js")
  script(src="/admin/js/my-tinymce-config.js")
