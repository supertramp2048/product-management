head 
  meta(charset=UTF-8)
  meta(name="viewport", content="width=device-width, initial-scale=1.0")
  title= title 
  link(rel="stylesheet", href="/css/output.css")
  style.
    body {
      background: linear-gradient(135deg, #ece9ff 0%, #d6eaff 100%);
      min-height: 100vh;
    }

body
  include ../../mixins/alertSuccess.pug
  +alertSuccess(3000)
  +alertFail(3000)
  .flex.items-center.justify-center.min-h-screen
    form(
      action= `${prefixAdmin}/auth/login`
      method="POST"
      class="bg-white shadow-2xl rounded-2xl p-10 max-w-md w-full border border-gray-100"
    ) 
      .mb-8.text-center
        h1.text-3xl.font-bold.text-blue-700.mb-2 Login
        p.text-gray-500.text-base Tracking your admin credentials

      table.w-full.table-auto
        tr.leading-10
          td(class="w-1/3 font-semibold text-gray-700 py-3 ") 
            label(for="username" class="block mb-1") Email *
          td.py-3 
            input(
              type="text" 
              id="email" 
              name="email" 
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 transition"
              placeholder="Enter username here"
              required
            )
        tr.leading-10
          td(class="w-1/3 font-semibold text-gray-700 py-3 ") 
            label(for="password" class="block mb-1") Password *
          td.py-3 
            input(
              type="password" 
              id="password" 
              name="password" 
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-gray-50 transition"
              placeholder="Enter password here"
              required
            )
        tr.leading-10
          td(colspan="2" class="pt-6 text-right flex justify-end gap-3")
            button(
              type="button" 
              class="px-4 py-2 text-gray-600 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-400 font-semibold transition"
              onclick="window.location.href=`/admin/auth/login`"
            ) Cancel
            button(
              type="submit" 
              class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 font-semibold shadow-md transition"
              id="submit-btn" 
            ) Login  
  script(src="/admin/js/script.js")