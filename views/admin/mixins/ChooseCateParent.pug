//- mixin choosenParent(categories,prefix="")
//-       each category,index in categories 
//-         - const isLast = index === categories.length - 1
//-         - const connector = isLast ? "└── " : "├── "
//-         option(value=category._id class="p-0") #{prefix} #{connector} #{category.title} 
//-         if category.child 
//-           - const newIslast = isLast ? "----" : "│   "
//-           - const newPrefix = prefix + newIslast
//-           +choosenParent(category.child,newPrefix)
mixin choosenParent(categories,level,currentParent_id)
  each category in categories 
    - var prefix = Array(level + 1).join("---")
    option(
      value=category._id
      selected=(String(category._id) === String(currentParent_id))
    ) #{prefix} #{category.title} 
    if category.child 
      - var newlevel = level + 1
      +choosenParent(category.child, newlevel, currentParent_id)