include ../../client/mixins/category.pug
include ../../client/mixins/search.pug

header(class="w-full h-28 flex justify-center items-center bg-slate-100")   
  div(class="flex w-full lg:w-4/5 items-center")        
    div(class="basis-3/12 hidden lg:block items-center justify-center")       
      a(href="/")         
        img(src="/images/logo.png", alt="logo" class="object-contain") 
    div(class="basis-4/12 w-full flex items-center mr-3")       
      +search(keySearch)     
    div(class="basis-5/12 flex items-center justify-center")       
      ul(class="flex gap-5 main items-center z-50")          
        li(class="border border-slate-500 p-2 rounded-md")            
          a(href="/") Home         
        li(class="border border-slate-500 p-2 rounded-md")            
          a(href="/products") Product         
        li(class="border border-slate-500 p-2 rounded-md")
          | Category           
          +chooseCategory(layoutCategory) 
      div(class="relative ml-6 p-2")
        a(href="/cart" class="text-3xl") <i class="fa-solid fa-cart-shopping"></i>
        if(count && count >0)
          span(class="absolute block rounded-xl top-0 right-0 bg-red-500 w-5 leading-5 text-white text-center") #{count}
