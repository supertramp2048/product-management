mixin productGrid(products) 
  div(class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2")
        each product in products
          if product.status == "active"
            div(class="bg-white rounded-xl shadow p-2")
              div
                a(href=`/products/productDetail/${product.slug}/${product._id}`) 
                  img(src=product.thumbnail, alt=product.title class="w-auto h-[200px] object-cover rounded-lg")
              div 
                p(class="min-h-16 font-semibold text-gray-800") #{product.title} 
                p(class="text-green-600 font-bold") #{product.price} 