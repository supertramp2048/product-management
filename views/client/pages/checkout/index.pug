extends ../../layouts/default.pug
block main 
  h1(class="text-3xl font-bold text-green-700") Giỏ hàng
  div 
    each item in cart
      .cart-item.flex.gap-4.items-center.border-b.py-4
        img.w-20.h-20.object-cover.rounded(src=item.thumbnail alt=item.title)
        .flex-1
            h3.text-lg.font-semibold #{item.title}
            .flex.items-center.gap-2
              span.ml-4.font-semibold.text-red-600 #{item.price - item.price * item.discountPercentage / 100}đ
              del.ml-4.font-semibold.text-gray-600 #{item.price}
            p số lượng: 
              span(class="rounded-md pl-2 pr-2 border") #{item.quantity}
    div(class="flex gap-4 items-center justify-between border-b py-4")
      p(class="text-2xl font-bold") Tổng tiền 
      div(class="flex")
        p(class="pr-4 font-semibold text-2xl") #{total} đ
    div(class="w-full max-w-xs")
  div(class="w-full max-w-xs")
  form(
    action="/checkout/order"
    method="POST"
    name="userInfo"
    id="userInfo"
    class="bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4"
    )
    div(class="mb-4")
      label(for="fullname" class="block text-gray-700 text-sm font-bold mb-2") Họ tên người nhận
      input(id="fullname" name="fullname" type="text" placeholder="fullname" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline")
    div(class="mb-4")
      label(for="address" class="block text-gray-700 text-sm font-bold mb-2") Địa chỉ 
      input(id="address" name="address" type="text" placeholder="address" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline")
    div(class="mb-4")
      label(for="phone" class="block text-gray-700 text-sm font-bold mb-2") Số điện thoại
      input(id="phone" name="phone" type="text" placeholder="phone" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline")
    div(class="flex items-center justify-between")
      button(type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline") Đặt hàng
      a(href="#" class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800") Forgot Password?
  p(class="text-center text-gray-500 text-xs")
