extends ../../layouts/default.pug
block main 
  h1(class="text-3xl font-bold text-red-500") Giỏ hàng
  div 
    each item in cart
      .cart-item.flex.gap-4.items-center.border-b.py-4
        img.w-20.h-20.object-cover.rounded(src=item.thumbnail alt=item.title)
        .flex-1
            h3.text-lg.font-semibold #{item.title}
            .flex.items-center.gap-2
            button.px-2.py-1.border.rounded(type="button" minus data-product-id=item.product_id) -
            span #{item.quantity}
            button.px-2.py-1.border.rounded(type="button" plus data-product-id=item.product_id) +
            span.ml-4.font-semibold.text-red-600 #{Math.round((item.price - item.price * item.discountPercentage / 100) *100) * item.quantity / 100}đ
            del.ml-4.font-semibold.text-gray-600 #{item.price}
        button.ml-4.px-2.py-1.text-white.bg-red-500.rounded(type="button" cart-delete-product-btn data-product-id=item.product_id) Xóa
    div(class="flex gap-4 items-center justify-between border-b py-4")
      p(class="text-2xl font-bold") Tổng tiền 
      div(class="flex")
        p(class="pr-4 font-semibold text-2xl") #{total}
        a(href="/checkout" class="btn-primary leading-8") Thanh toán
    form(action="",
        class="hidden"
        name="updateCart"
        update-cart-form
        pathUpdateCart = "/cart/update"
        method="post") 

        input(type="text" name="product_id" )
  script(src="/client/js/cart.js") 